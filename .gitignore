# Virtual environment
.venv/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# IDE / editor settings
.vscode/
.idea/

# Runtime Logs & Orchestrator State Snapshots
# Prevents student state tracking files and local execution artifacts from leaking into git
logs/
.run/
*.log
*.pid
*.sock
*.tmp

# Environment variables (Strictly Private)
.env
.env.*

# Local Scratchpads, Private Notes & Docs
.notes/
private/
docs/notes.txt

# OS-specific junk
.DS_Store
Thumbs.db

# Build & Package Distribution Artifacts
*.egg-info/

# Local student registry session databases
data/