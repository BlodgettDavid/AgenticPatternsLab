# Virtual environment
.venv/

# Python cache & test artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# IDE / editor settings
.vscode/
.idea/

# Runtime Logs & Orchestrator State Snapshots
# Prevents student state tracking files and local execution artifacts from leaking into git
logs/*
!logs/.gitkeep
.run/
*.log
*.pid
*.sock
*.tmp

# Environment variables (Strictly Private)
.env
.env.*

# Local Scratchpads, Private Notes & Docs
.notes/
private/
docs/notes.txt

# OS-specific junk
.DS_Store
Thumbs.db

# Build & Package Distribution Artifacts
*.egg-info/
AgenticPatternsLab.egg-info/

# Ignore all contents inside the results/ directory
results/*

# But explicitly allow the .gitkeep file so the folder structure is tracked
!results/.gitkeep